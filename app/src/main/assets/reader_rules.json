      "strip": [".article-body--right-rail-container", "[data-testid=\"article-subscriber-gate\"]", "[data-testid=\"body-bottom-recommended\"]"]
    },
    {
      "match": ["cbsnews.com"],
      "include": [".content__body"],
      "strip": [".content__body--footer", ".content__cta"]
