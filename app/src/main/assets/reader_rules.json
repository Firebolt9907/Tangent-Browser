{
  "version": 35,
  "_schema": "Per-site reader overrides interpreted by the fixed extractor (data, not code). Each rule: 'match' = hostname or ['host', ...] (bare domain also matches subdomains; leading '*.' allowed); 'include' = CSS selector(s) for the real article container (first visible match wins, bypasses the heuristic); 'strip' = CSS selector(s) whose subtrees are dropped before extraction. include/strip may be a string or an array. Selectors containing a newline or '//' are rejected at load. include/strip are no-ops when their selectors don't match, so an unverified rule cannot regress other pages — only reshape the named host.",
  "_examples_note": "Rules validated against live article DOM by the reader-mode agent loop. include selectors are the true article-body container; strip selectors drop in-body ads / related-coverage / bio boxes the generic boilerplate filter misses. Do NOT add strips already covered by the generic BOILERPLATE_SEL in the extractor: word-boundary ad classes (ad/ads/ad-*/ads-*/-ad/-ads/_ad, e.g. .ad, .ad-slot, .ad-unit, .sticky-ad, .*-ad), .taboola/.outbrain, *recirc*, and the substring matchers share/social/related/newsletter/subscribe/subscription/comment/breadcrumb/advert/sponsor/promo/credit/disclaimer/affiliate/category/toolbar, plus the nav/aside/footer/form elements. Only add site strips the generic filter does NOT catch (e.g. .sidebar, *video*, *paywall*, author/byline boxes, data-* / aria-* attribute selectors, CMS-specific classes like .infobox/.navbox/.votecell).",
  "rules": [
    {
      "match": ["theguardian.com"],
      "include": ["[data-gu-name=\"body\"]"]
    },
    {
      "match": ["arstechnica.com"],
      "include": ["div.article-content", "section.article-content"],
      "strip": [".sidebar", "figure.video"]
    },
    {
      "match": ["bbc.com", "bbc.co.uk"],
      "include": ["article"],
      "strip": ["[data-component=\"ad-slot\"]", "[data-component=\"tag-list-block\"]", "[data-component=\"links-block\"]"]
    },
    {
      "match": ["apnews.com"],
      "include": [".RichTextStoryBody"],
      "strip": [".Enhancement-item"]
    },
    {
      "match": ["npr.org"],
      "include": ["#storytext", ".storytext"],
      "strip": [".bucketwrap.internallink", ".enlarge-options"]
    },
    {
      "match": ["cnn.com"],
      "include": [".article__content"],
      "strip": [".video-resource", ".zn-body__read-all"]
    },
    {
      "match": ["foxnews.com"],
      "include": [".article-body"],
      "strip": [".featured-video", ".author-byline"]
    },
    {
      "match": ["theverge.com"],
      "include": [".duet--layout--entry-body"]
    },
    {
      "match": ["aljazeera.com"],
      "include": [".wysiwyg--all-content"]
    },
    {
      "match": ["techcrunch.com"],
      "include": [".entry-content", ".wp-block-post-content"],
      "strip": [".marfeel-experience-inline"]
    },
    {
      "match": ["cnbc.com"],
      "include": [".ArticleBody-articleBody"],
      "strip": [".InlineVideo"]
    },
    {
      "match": ["nbcnews.com"],
      "include": [".article-body"],
      "strip": [".article-body--right-rail-container", "[data-testid=\"article-subscriber-gate\"]", "[data-testid=\"body-bottom-recommended\"]"]
    },
    {
      "match": ["cbsnews.com"],
      "include": [".content__body"],
      "strip": [".content__body--footer", ".content__cta"]
    },
    {
      "match": ["wired.com"],
      "include": [".article__body", ".body__container"],
      "strip": [".article-body__footer", ".consumer-marketing-unit"]
    },
    {
      "match": ["vox.com"],
      "include": [".duet--layout--entry-body"]
    },
    {
      "match": ["businessinsider.com"],
      "include": [".post-body-content"],
      "strip": [".inline-backup-paywall", ".premium-cta"]
    },
    {
      "match": ["forbes.com"],
      "include": [".article-body"],
      "strip": [".fs-responsive-ad", ".article-sharing", ".paywall_ribbon"]
    },
    {
      "match": ["nytimes.com"],
      "include": ["section[name=\"articleBody\"]", "article#story"],
      "strip": ["[data-testid=\"inline-message\"]", ".bottom-of-article"]
    },
    {
      "match": ["nypost.com"],
      "include": [".single__content"]
    },
    {
      "match": ["theatlantic.com"],
      "include": ["[data-event-module=\"article body\"]", ".article-content-body"],
      "strip": ["[data-event-module=\"author footer\"]", "[data-event-module=\"footer\"]"]
    },
    {
      "match": ["newsweek.com"],
      "include": [".meteredContent", "[class*=\"articleBody\"]"]
    },
    {
      "match": ["chicagotribune.com"],
      "include": [".article-body"]
    },
    {
      "match": ["washingtonpost.com"],
      "include": [".grid-body", ".meteredContent"],
      "strip": ["[data-qa=\"article-body-ad\"]", "[data-qa=\"sc-newsletter-signup-body\"]"]
    },
    {
      "match": ["reuters.com"],
      "include": ["[data-testid=\"article-body\"]", ".article-body__content__"],
      "strip": ["[data-testid=\"sponsored-content\"]", "[aria-label=\"advertisement\"]", "[data-testid=\"read-next\"]"]
    },
    {
      "match": ["gizmodo.com"],
      "include": [".entry-content"],
      "strip": [".commerce-widget"]
    },
    {
      "match": ["propublica.org"],
      "include": [".article-body", ".entry-content"]
    },
    {
      "match": ["thehill.com"],
      "include": [".article__text"],
      "strip": [".instaread-player", ".rollmenu"]
    },
    {
      "match": ["thedailybeast.com"],
      "include": [".b-article-body"]
    },
    {
      "match": ["semafor.com"],
      "include": [".article-content"]
    },
    {
      "match": ["variety.com", "rollingstone.com"],
      "include": [".a-content"],
      "strip": [".a-content-ignore", ".pmc-paywall"]
    },
    {
      "match": ["newyorker.com"],
      "include": [".article__body", ".body__container"],
      "strip": [".consumer-marketing-unit", ".paywall-bar"]
    },
    {
      "match": ["scientificamerican.com"],
      "include": ["[class*=\"article__body\"]"]
    },
    {
      "match": ["salon.com"],
      "include": [".article__content"]
    },
    {
      "match": ["substack.com"],
      "include": [".available-content", ".body.markup"],
      "strip": [".button-wrapper", ".paywall-jump"]
    },
    {
      "match": ["github.blog"],
      "include": [".post__content"],
      "strip": [".post-tags", ".author-bio", ".post__navigation"]
    },
    {
      "match": ["dev.to"],
      "include": ["#article-body", ".crayons-article__body"],
      "strip": [".crayons-article__actions", ".article-actions", ".ltag__user"]
    },
    {
      "match": ["developer.mozilla.org"],
      "include": [".main-page-content", "main#content"],
      "strip": [".baseline-indicator", ".article-footer", ".content-feedback", ".metadata", ".language-menu", ".on-github", ".sidebar"]
    },
    {
      "match": ["stackoverflow.com", "stackexchange.com", "superuser.com", "serverfault.com", "askubuntu.com", "mathoverflow.net"],
      "include": ["#mainbar"],
      "strip": [".votecell", ".js-vote-count", ".post-menu", ".js-post-menu", ".post-signature", ".user-info", ".post-notice", ".js-post-notice", "#post-form", ".answer-form", ".js-add-link", ".bottom-notice", "#answers-header", ".js-saves", ".js-follow-post", ".s-sidebarwidget"]
    },
    {
      "match": ["docs.python.org"],
      "include": ["[role=\"main\"]", ".body"],
      "strip": [".headerlink", ".sphinxsidebar", ".admonition-title"]
    },
    {
      "match": ["readthedocs.io"],
      "include": ["[role=\"main\"]", ".document", ".rst-content", ".body"],
      "strip": [".headerlink", ".wy-nav-side", ".rst-footer-buttons", ".rst-versions", ".ethical-rtd", ".admonition-title"]
    },
    {
      "match": ["gitbook.com", "gitbook.io"],
      "include": ["main"],
      "strip": ["[data-testid=\"page.footer\"]", ".page-footer"]
    },
    {
      "match": ["fandom.com"],
      "include": [".mw-parser-output"],
      "strip": [".portable-infobox", ".navbox", ".references", ".reflist", ".mw-references-wrap", ".toc", ".mw-editsection", ".noprint", ".printfooter", ".gallery", ".wikia-gallery", ".notice", ".ambox", ".messagebox", ".hatnote", ".dablink", ".reference", ".navbox-styles"]
    },
    {
      "match": ["wikipedia.org"],
      "include": [".mw-parser-output"],
      "strip": [".infobox", ".navbox", ".reflist", ".references", ".mw-references-wrap", ".hatnote", ".navigation-not-searchable", ".sistersitebox", ".noprint", ".mw-editsection", ".shortdescription", ".toc", "#toc", ".sidebar", ".metadata", ".ambox", ".gallery", ".catlinks", "table.vertical-navbox", ".portal", ".refbegin", ".mw-empty-elt", ".reference"]
    },
    {
      "match": ["nature.com", "springer.com", "biomedcentral.com", "springeropen.com"],
      "include": [".c-article-body", ".c-article-main-column", ".main-content"],
      "strip": [".c-article-author-information", ".c-bibliographic-information", ".c-article-references", ".c-article-further-reading", ".c-article-associated-content", ".c-article-recommendations", ".c-article-metrics-bar", ".c-article-share-box", ".c-article-social-list", ".c-pdf-download", ".c-nature-box", ".c-article-supplementary", ".app-article-access", ".c-article-editorial-summary", ".c-article-rightslink", ".c-article-section__figure-description"]
    },
    {
      "match": ["plos.org"],
      "include": ["#articleText"],
      "strip": [".references", "#references", ".author-info", ".articleinfo", ".figure-expand", ".figure-link", ".figure-inline-download", ".supplementary-material", ".articleinfo-authors", ".author-list"]
    },
    {
      "match": ["arxiv.org", "ar5iv.org", "ar5iv.labs.arxiv.org"],
      "include": [".ltx_page_content", "article.ltx_document"],
      "strip": [".ltx_bibliography", ".ltx_authors", ".ltx_role_footnote", ".ltx_pagination", ".ltx_page_logo", ".ltx_page_footer", ".ltx_dates", ".ltx_classification"]
    },
    {
      "match": ["github.com"],
      "include": [".markdown-body"],
      "strip": [".zeroclipboard-container", ".js-clipboard-copy", ".snippet-clipboard-content .zeroclipboard-container", ".markdown-heading .anchor"]
    },
    {
      "match": ["freecodecamp.org"],
      "include": [".post-content", ".post-full-content"],
      "strip": [".author-card", ".read-next-card", ".subscribe-form", ".post-full-footer", ".gh-post-upgrade", ".kg-card.kg-signup-card"]
    },
    {
      "match": ["biorxiv.org", "medrxiv.org"],
      "include": [".fulltext-view", ".article.fulltext-view"],
      "strip": [".ref-list", ".fn-group", ".supplementary-material", ".section-nav", ".highwire-cite", ".article-metrics", ".contributors", ".copyright-statement"]
    },
    {
      "match": ["geeksforgeeks.org"],
      "include": [".article--viewer_content"],
      "strip": [".similar-reads", ".article-buttons", ".improve-article-desktop", ".responsive-tabs-list", ".secondary_box", ".article-pgnavi", ".three_dot_dropdown", ".gfg-author-details", ".adsbygoogle"]
    },
    {
      "match": ["britannica.com"],
      "include": [".topic-content"],
      "strip": [".md-assembly", ".marketing-cta", ".md-related-box", ".byline", ".md-nsf-container", ".feedback-block", ".topic-toc", ".md-source-lower", ".md-quiz-box", ".related-content"]
    },
    {
      "match": ["investopedia.com", "verywellhealth.com", "verywellmind.com", "verywellfit.com", "verywellfamily.com", "thespruce.com", "thespruceeats.com", "simplyrecipes.com", "allrecipes.com", "seriouseats.com", "byrdie.com", "liveabout.com", "thoughtco.com", "treehugger.com", "people.com", "realsimple.com", "southernliving.com", "marthastewart.com", "thebalancemoney.com", "lifewire.com", "tripsavvy.com", "food.com"],
      "include": [".article-body-content", ".mntl-sc-page", ".comp.article-body"],
      "strip": [".mntl-sc-block-adhesivead", ".js-mntl-ad", ".mntl-block--ad", ".comp.article-sources", ".mntl-sc-block-newsletterform", ".mntl-sc-block-callout--newsletter", ".comp.mntl-recirc"]
    },
    {
      "match": ["techradar.com", "tomshardware.com", "pcgamer.com", "gamesradar.com", "livescience.com", "space.com", "tomsguide.com", "windowscentral.com", "androidcentral.com", "imore.com", "creativebloq.com", "t3.com", "whathifi.com", "musicradar.com", "guitarworld.com", "cinemablend.com"],
      "include": ["#article-body", ".text-copy"],
      "strip": [".ad-unit", ".hawk-nest", ".fancy-signup", ".newsletter-form", ".slice-container", ".more-about", ".van_vid_carousel", ".social-share", "[class*=\"hawk\"]", "[class*=\"newsletter\"]", "[class*=\"affiliate\"]"]
    },
    {
      "match": ["cosmopolitan.com", "esquire.com", "elle.com", "harpersbazaar.com", "popularmechanics.com", "caranddriver.com", "roadandtrack.com", "goodhousekeeping.com", "menshealth.com", "womenshealthmag.com", "runnersworld.com", "bicycling.com", "prevention.com", "delish.com", "housebeautiful.com", "countryliving.com", "townandcountrymag.com", "oprahdaily.com", "seventeen.com", "bestproducts.com"],
      "include": [".article-body-content", ".standard-body-content"],
      "strip": [".ad-container", ".social-share", "[class*=\"newsletter\"]", "[class*=\"affiliate\"]", "[class*=\"recirc\"]", "[class*=\"related-\"]", "[data-theme-key=\"social-share\"]"]
    }
  ]
}
