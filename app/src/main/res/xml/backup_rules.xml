<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 30 and below (allowBackup="true" in the manifest).
   API 31+ uses data_extraction_rules.xml instead.

   Everything is backed up by default; we exclude the credential/session material so a copy of
   the saved-password store and the live Firefox-Sync session never lands in a Google Drive backup:
     - tangent_logins.db (+ WAL/SHM) — the encrypted PlacesLoginsStorage password database. Its AES
       key lives in the AndroidKeyStore (device-bound, never backed up), so a restored copy is
       undecryptable anyway; excluding it avoids shipping credential ciphertext off-device.
     - fxaStateAC.xml — android-components' default SharedPrefAccountStorage file holding the FxA
       account/session state (OAuth + sync keys). Excluding it stops a restored backup from
       carrying an authenticated sync session.
     - tangent_logins_key.xml — holds the logins DB key sealed under a device-bound AndroidKeyStore
       key. The seal is useless off-device (the wrapping key isn't backed up), but we exclude the
       credential-key ciphertext anyway, matching the DB exclusion above.
-->
<full-backup-content>
    <exclude domain="database" path="tangent_logins.db" />
    <exclude domain="database" path="tangent_logins.db-wal" />
    <exclude domain="database" path="tangent_logins.db-shm" />
    <exclude domain="sharedpref" path="fxaStateAC.xml" />
    <exclude domain="sharedpref" path="tangent_logins_key.xml" />
</full-backup-content>
