{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "reader@tangent.firebolt9907"
    }
  },
  "name": "Tangent Reader Extractor",
  "description": "Extracts article content for reader mode from an isolated content script, so hostile pages cannot observe or intercept it.",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extractor.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
