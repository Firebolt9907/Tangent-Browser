<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen search widget: a Google-style pill. Tapping the search area opens a fresh tab ready to
  type (ACTION_NEW_TAB); tapping the mic launches voice search (ACTION_VOICE_SEARCH). RemoteViews-only
  (no custom views), so it renders in the launcher process.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_search_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Search affordance (icon + hint) — opens a new tab in editing mode. -->
    <LinearLayout
        android:id="@+id/widget_search_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_widget_search"
            android:contentDescription="@string/widget_search_hint" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_search_hint"
            android:textColor="#5F6368"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Voice search. -->
    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="@string/widget_voice_search" />
</LinearLayout>
