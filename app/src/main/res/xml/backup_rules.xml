<?xml version="1.0" encoding="utf-8"?>
<!--
    Back up only reviewed UI preferences. Android otherwise includes app files, databases and
    shared preferences by default, including Gecko session data and future credential stores.
    Browsing/session data, form memory, autofill approvals, site permission grants, account state,
    keys, screenshots and crash dumps must stay on this device. Firefox Sync is independent.
    New stores are NOT eligible until explicitly reviewed here and in the other rules file.
-->
<full-backup-content>
    <include domain="sharedpref" path="tangent_global_prefs.xml" />
    <include domain="sharedpref" path="tangent_site_prefs.xml" />
    <include domain="sharedpref" path="tangent_zapped_elements.xml" />
</full-backup-content>
