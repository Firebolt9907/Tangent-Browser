{
  "manifest_version": 3,
  "name": "Tangent Reader",
  "description": "One-click distraction-free reader view. Click the toolbar button to toggle a clean overlay of the article; click again to dismiss.",
  "version": "1.0.1",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Toggle Reader view"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "reader-standalone@tangent.firebolt9907",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
