<?xml version="1.0" encoding="utf-8"?>
<!--
  Exposes a "shared" subfolder of the app cache to other apps via a content:// URI so we can put an
  actual image on the clipboard / into a share sheet. Only this narrow subdir is shared, never the
  whole cache. Used by ui/content/ImageClipboard.kt.
-->
<paths>
    <cache-path name="shared" path="shared/" />
    <!-- Files captured out of blob: URLs (state/BlobFiles.kt), so a captured PDF can be handed to
         another app. Same narrow-subdir rule as "shared". -->
    <cache-path name="blobs" path="blobs/" />
</paths>
